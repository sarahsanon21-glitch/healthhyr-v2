# Copy to apps/web/.env.local (git-ignored) and fill in. Never commit real values.
#
# Every value here is PUBLIC: it is compiled into the website and anyone can read it.
# This app never holds a secret. Do not put a Supabase secret key, a service-role key or a
# Stripe key in any NEXT_PUBLIC_ variable. The site refuses to start if the Supabase key looks secret.

# Base URL of the HealthHyr API (the Express server). The /api/v1 prefix is added by the app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase project URL, and the PUBLISHABLE key (not the secret key).
# For local development, copy "API_URL" and "PUBLISHABLE_KEY" from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
