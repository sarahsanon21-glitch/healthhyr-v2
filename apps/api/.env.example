# API environment. Copy to apps/api/.env (git-ignored) and fill in. Never commit real values.
# These are SERVER-ONLY secrets. They live here and nowhere else: not in the web app, not in shared code.

NODE_ENV=development
PORT=4000

# Supabase. For local development, copy the values from `npm run db:status`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row-level security. Used only by server-only operations (webhooks, publish, expiry, admin).
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json and <SUPABASE_URL>/auth/v1
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Stripe. Test keys only while building (sk_test_...). A live key is refused outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated browser origins allowed to call the API. Required in production.
# Development default: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Number of reverse proxies in front of the API (so rate limiting sees the real client IP).
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
