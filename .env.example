# Local development only. Copy to .env (git-ignored) and fill in. Never commit real values.
# `npm run db:status` prints the values for the local Supabase (in a private terminal).

# Connection string of the local Supabase database, used by the RLS tests (npm run test:rls).
# Copy "DB_URL".
RLS_DATABASE_URL=

# Local Supabase API URL and anon key, used by the API integration tests (apps/api/tests/integration).
# Copy "API_URL" and "ANON_KEY". The anon key is public by design, but keep it out of the repo anyway.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The LOCAL service-role key, used only by the API integration tests that exercise server-only
# operations (close, reopen, cancel checkout) against the real local database. Copy "SERVICE_ROLE_KEY".
# This bypasses row-level security, so never put a production key here.
SUPABASE_SERVICE_ROLE_KEY=
